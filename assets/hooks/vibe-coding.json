{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "get_command_or_subagent_output",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"__GROK_HOME__\\vibe-tools\\scripts\\run-vibe-gate-chat.ps1\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "search_replace|Write|Edit|MultiEdit|write|use_tool|serena__replace_content|serena__replace_symbol_body|serena__insert_after_symbol|serena__insert_before_symbol|serena__replace_in_files",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"__GROK_HOME__\\vibe-tools\\scripts\\run-vibe-on-edit.ps1\"",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"__GROK_HOME__\\vibe-tools\\scripts\\run-vibe-prompt-context.ps1\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"__GROK_HOME__\\vibe-tools\\scripts\\run-vibe-stop-remind.ps1\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
